{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [
    "scripts/build-react-styles.ts",
    "scripts/check-react-dist.ts",
    "scripts/workspace.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "//#format:check": {
      "cache": false
    },
    "preview:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "spec:lint": {
      "dependsOn": ["^build"]
    },
    "conformance:mock": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
