# Copy to .env.local (ignored by git), fill in, then build again: NEXT_PUBLIC_* values are inlined by `next build`,
# so pointing the app at another deployment is a rebuild, not a runtime switch.
# Placeholders only. Real values do not belong in this repository.

# The approvals API's origin: scheme, host and port, no path, no trailing slash. It is also the `resource` of the
# sign-in, so the access token is issued for this origin.
NEXT_PUBLIC_NC_API_URL=https://govern.example.test

# The sign-in service's issuer; its endpoints come from its metadata document.
NEXT_PUBLIC_NC_ISSUER=https://auth.example.test

# The id of the public client registered for this app (`bun run register-client` in packages/react). Not a secret.
NEXT_PUBLIC_NC_CLIENT_ID=bnoauth_REPLACE_ME

# Where the sign-in returns to: exactly this page, on the origin the app runs on.
NEXT_PUBLIC_NC_REDIRECT_URI=http://localhost:3000/approvals/callback

# Where the permissions page's sign-in returns to: its own callback, so each page's sign-in lands on its own route.
NEXT_PUBLIC_NC_PERMISSIONS_REDIRECT_URI=http://localhost:3000/permissions/callback

# The roles the permissions page shows as columns, before the roles its policies name (comma-separated keys).
NEXT_PUBLIC_NC_ROLES=member

# Mock mode, for local work against `nc-mock` (no sign-in service): the approvals page takes the approver's token
# from the mock (the permissions page its administrator's) and says so in a banner. Only NEXT_PUBLIC_NC_API_URL is needed then, e.g. http://127.0.0.1:8787.
# NEXT_PUBLIC_NC_MODE=mock
