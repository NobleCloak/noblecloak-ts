{
  "name": "@noblecloak/react",
  "version": "0.9.0",
  "description": "React governance modules for NobleCloak.",
  "license": "Apache-2.0",
  "author": "NobleCloak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NobleCloak/noblecloak-ts.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals.d.ts",
      "import": "./dist/approvals.js"
    },
    "./action-status": {
      "types": "./dist/action-status.d.ts",
      "import": "./dist/action-status.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "import": "./dist/connections.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "import": "./dist/slots.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && bun ../../scripts/check-react-dist.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "register-client": "bun tools/register-client.ts",
    "clean": "rm -rf dist coverage storybook-static test-results .turbo",
    "preview:build": "storybook build --quiet",
    "preview": "storybook dev -p 6006"
  },
  "dependencies": {
    "@noblecloak/client": "workspace:*",
    "@noblecloak/theme": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@noblecloak/policy-formats": "workspace:*",
    "@noblecloak/spec": "workspace:*",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5"
  }
}
