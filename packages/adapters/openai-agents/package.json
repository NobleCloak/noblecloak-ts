{
  "name": "@noblecloak/openai-agents",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAI Agents SDK adapter for NobleCloak governance.",
  "license": "Apache-2.0",
  "author": "NobleCloak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NobleCloak/noblecloak-ts.git",
    "directory": "packages/adapters/openai-agents"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
