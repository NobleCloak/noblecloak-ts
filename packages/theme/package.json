{
  "name": "@noblecloak/theme",
  "version": "0.1.2",
  "description": "NobleCloak design tokens and a small set of slot-replaceable primitives, scoped to the module root.",
  "license": "Apache-2.0",
  "author": "NobleCloak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NobleCloak/noblecloak-ts.git",
    "directory": "packages/theme"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./components.css": "./dist/components.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "tokens:generate": "bun tools/generate-tokens-json.ts",
    "size": "bun tools/check-size.ts",
    "e2e": "playwright test",
    "clean": "rm -rf dist coverage storybook-static test-results .turbo",
    "preview:build": "storybook build --quiet",
    "preview": "storybook dev -p 6007"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3"
  }
}
